<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Gestión de Productos | Admin NIRAMI</title>
    <link rel="stylesheet" th:href="@{/assets/css/admin.css}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&family=Suez+One&display=swap" rel="stylesheet">
</head>
<body>

<header th:replace="~{fragments/headerAdmin :: header-admin-nirami}"></header>

<main>
    <div th:if="${mensajeExito}" class="alert alert-success" th:text="${mensajeExito}"></div>
    <div th:if="${mensajeError}" class="alert alert-error" th:text="${mensajeError}"></div>

    <div class="panel">
        <div class="panel-header">
            <span>Todos los Productos (<span th:text="${productos != null ? #lists.size(productos) : 0}">0</span>)</span>
        </div>
        <div class="tabla-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Imagen</th>
                        <th>Nombre</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr th:each="prod : ${productos}">
                        <td th:text="${prod.idProducto}"></td>
                        <td>
                            <img th:if="${prod.imagenProducto != null}"
                                 th:src="@{'/assets/imagenes/imgproductos/' + ${prod.imagenProducto}}"
                                 style="width:50px;height:50px;object-fit:cover;border-radius:6px;">
                            <img th:unless="${prod.imagenProducto != null}"
                                 th:src="@{/assets/imagenes/imgPerfil/Avatar.png}"
                                 style="width:50px;height:50px;object-fit:cover;border-radius:6px;opacity:.4;">
                        </td>
                        <td>
                            <strong th:text="${prod.nombreProducto}"></strong>
                            <small style="display:block;color:#888;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                                   th:text="${prod.descripcionProducto}"></small>
                        </td>
                        <td>
                            <span class="badge badge-azul"
                                  th:text="${prod.categoria != null ? prod.categoria.nombreCategoria : '-'}"></span>
                        </td>
                        <td style="font-weight:700;color:#4586FF;"
                            th:text="'$' + ${#numbers.formatDecimal(prod.precioProducto,1,'COMMA',0,'POINT')}"></td>
                        <td>
                            <span th:text="${prod.cantidadProducto}"
                                  th:class="${prod.cantidadProducto > 0 ? 'badge badge-verde' : 'badge badge-rojo'}"></span>
                        </td>
                        <td><span class="badge badge-verde">Disponible</span></td>
                        <td>
                            <form th:action="@{/vendor/producto/eliminar}" method="post" style="display:inline;"
                                  onsubmit="return confirm('¿Desactivar este producto?');">
                                <input type="hidden" name="idProducto" th:value="${prod.idProducto}">
                                <button type="submit" class="btn btn-naranja">Desactivar</button>
                            </form>
                        </td>
                    </tr>
                    <tr th:if="${productos == null or #lists.isEmpty(productos)}">
                        <td colspan="8" style="text-align:center;padding:30px;color:#999;">No hay productos registrados.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</main>
</body>
</html>
