<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Iniciar Sesión | NIRAMI</title>
    <link rel="stylesheet" th:href="@{/assets/css/login.css}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&family=Suez+One&display=swap" rel="stylesheet">
</head>
<body>
<section class="auth-page">

    <div class="auth-avatar">
        <i class="fa-solid fa-user"></i>
    </div>

    <div th:if="${session.mensajeError}" class="alert alert-error" th:text="${session.mensajeError}"
         style="max-width:600px;width:100%;margin-bottom:15px;padding:12px 20px;border-radius:6px;background:#f8d7da;color:#721c24;border:1px solid #f5c6cb;font-size:.9rem;"></div>
    <div th:if="${session.mensajeExito}" class="alert alert-success" th:text="${session.mensajeExito}"
         style="max-width:600px;width:100%;margin-bottom:15px;padding:12px 20px;border-radius:6px;background:#d4edda;color:#155724;border:1px solid #c3e6cb;font-size:.9rem;"></div>

    <div class="auth-card">
        <form action="/nirami_proyecto/auth/login" method="post">
            <div class="input-group">
                <i class="fa-solid fa-envelope"></i>
                <input type="email" name="correo" placeholder="Correo electrónico" required>
            </div>
            <div class="input-group">
                <i class="fa-solid fa-lock"></i>
                <input type="password" name="contrasena" placeholder="Contraseña" required>
            </div>
            <a href="#" class="forgot-link">¿Olvidó su contraseña?</a>
            <button type="submit" class="btn-primary">Iniciar sesión</button>
        </form>
        <div class="auth-footer">
            <p>¿No tienes cuenta? <a href="/nirami_proyecto/registro">Registrarse</a></p>
        </div>
    </div>

</section>
</body>
</html>
