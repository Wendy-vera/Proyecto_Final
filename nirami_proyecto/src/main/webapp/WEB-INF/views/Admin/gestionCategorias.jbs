<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Gestión de Categorías | Admin NIRAMI</title>
    <link rel="stylesheet" th:href="@{/assets/css/admin.css}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&family=Suez+One&display=swap" rel="stylesheet">
</head>
<body>

<header th:replace="~{fragments/headerAdmin :: header-admin-nirami}"></header>

<main>
    <div th:if="${mensajeExito}" class="alert alert-success" th:text="${mensajeExito}"></div>
    <div th:if="${mensajeError}" class="alert alert-error"   th:text="${mensajeError}"></div>

    <div style="display:flex;justify-content:flex-end;margin-bottom:16px;">
        <a th:href="@{/admin/categorias(crear=true)}" class="btn btn-turquesa">Nueva categoría</a>
    </div>

    <div class="form-panel" th:if="${mostrarFormulario}">
        <div class="form-panel-header"
             th:text="${categoriaEditar != null} ? 'Editar categoría' : 'Nueva categoría'">
        </div>
        <div class="form-panel-body">
            <form th:action="@{/admin/categoria/guardar}" method="post">
                <input type="hidden" name="idCategoria"
                       th:value="${categoriaEditar != null ? categoriaEditar.idCategoria : ''}">
                <div class="form-row">
                    <div class="form-group">
                        <label for="nombreCat">Nombre</label>
                        <input id="nombreCat" type="text" name="nombreCategoria" required
                               th:value="${categoriaEditar != null ? categoriaEditar.nombreCategoria : ''}"
                               placeholder="ej. Cerámica">
                    </div>
                    <div class="form-group">
                        <label for="descCat">Descripción</label>
                        <input id="descCat" type="text" name="descripcionCategoria"
                                th:value="${categoriaEditar != null ? categoriaEditar.descripcion : ''}"
                                placeholder="Breve descripción (opcional)">
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-turquesa">Guardar</button>
                    <a th:href="@{/admin/categorias}" class="btn btn-naranja">Cancelar</a>
                </div>
            </form>
        </div>
    </div>

    <div class="panel">
        <div class="panel-header">
            <span>Categorías (<span th:text="${categorias != null ? #lists.size(categorias) : 0}">0</span>)</span>
        </div>
        <div class="tabla-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr th:each="cat : ${categorias}">
                        <td th:text="${cat.idCategoria}"></td>
                        <td><strong th:text="${cat.nombreCategoria}"></strong></td>
                        <td th:text="${cat.descripcion != null ? cat.descripcion : '—'}"></td>
                        <td>
                            <span th:if="${cat.activa}"  class="badge badge-verde">Activa</span>
                            <span th:unless="${cat.activa}" class="badge badge-rojo">Inactiva</span>
                        </td>
                        <td style="display:flex;gap:8px;flex-wrap:wrap;">
                            <a th:href="@{/admin/categorias(editar=${cat.idCategoria})}"
                               class="btn btn-azul">Editar</a>
                            <form th:action="@{/admin/categoria/eliminar}" method="post"
                                  onsubmit="return confirm('¿Desactivar esta categoría?');">
                                <input type="hidden" name="idCategoria" th:value="${cat.idCategoria}">
                                <button type="submit" class="btn btn-naranja">Desactivar</button>
                            </form>
                        </td>
                    </tr>
                    <tr th:if="${categorias == null or #lists.isEmpty(categorias)}">
                        <td colspan="5" style="text-align:center;padding:30px;color:#999;">No hay categorías registradas.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</main>
</body>
</html>
