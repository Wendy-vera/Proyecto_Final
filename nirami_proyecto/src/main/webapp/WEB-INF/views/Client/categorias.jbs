<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Categorías | NIRAMI</title>
    <link rel="stylesheet" th:href="@{/assets/css/index.css}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&family=Suez+One&display=swap" rel="stylesheet">
</head>
<body>

<header th:replace="~{fragments/header :: header-nirami}"></header>

<main>
    <section class="seccion" style="padding-bottom:10px;">
        <h3 style="margin-bottom:15px;">Explorar categorías</h3>
        <div class="cards" style="flex-wrap:wrap;gap:10px;">
            
            <a th:href="@{/categorias}"
               class="card"
               th:classappend="${idCatActiva == null} ? ' active-cat' : ''"
               style="flex:0 0 auto;min-width:120px;padding:12px 20px;text-decoration:none;font-weight:600;font-size:.9rem;">
                Todas
            </a>
            
            <a th:each="cat : ${categorias}"
               th:href="@{/categorias(idCategoria=${cat.idCategoria})}"
               th:text="${cat.nombreCategoria}"
               th:classappend="${idCatActiva != null and idCatActiva == cat.idCategoria} ? ' active-cat' : ''"
               class="card"
               style="flex:0 0 auto;min-width:120px;padding:12px 20px;text-decoration:none;font-weight:600;font-size:.9rem;">
            </a>
        </div>
    </section>

    <section class="seccion" style="background:#fff;padding:30px 40px;">
        <div class="titulo">
            <h3>Productos</h3>
        </div>
        <div class="cards">
            <a th:each="prod : ${productos}"
               th:href="@{/producto(id=${prod.idProducto})}"
               class="card"
               style="text-decoration:none;flex-direction:column;align-items:flex-start;padding:0;overflow:hidden;max-width:240px;">
                <img th:if="${prod.imagenProducto != null}"
                     th:src="@{'/assets/imagenes/imgproductos/' + ${prod.imagenProducto}}"
                     style="width:100%;height:170px;object-fit:cover;">
                <img th:unless="${prod.imagenProducto != null}"
                     th:src="@{/assets/imagenes/imgPerfil/Avatar.png}"
                     style="width:100%;height:170px;object-fit:cover;">
                <div style="padding:15px;width:100%;">
                    <strong th:text="${prod.nombreProducto}" style="display:block;color:#303242;margin-bottom:4px;"></strong>
                    <small th:if="${prod.categoria != null}" th:text="${prod.categoria.nombreCategoria}" style="color:var(--naranja);"></small>
                    <p style="color:var(--azul);font-weight:700;margin-top:6px;" th:text="'$' + ${#numbers.formatDecimal(prod.precioProducto,1,'COMMA',0,'POINT')}"></p>
                </div>
            </a>
            <div th:if="${productos == null or #lists.isEmpty(productos)}" style="color:#999;padding:20px;text-align:center;width:100%;">
                No hay productos en esta categoría.
            </div>
        </div>
    </section>
</main>

<footer>
    <div><h4>NIRAMI</h4><p>Artesanías únicas</p></div>
    <div><h4>CATEGORÍAS</h4>
        <p th:each="cat : ${categorias}" th:text="${cat.nombreCategoria}"></p>
    </div>
    <div><h4>ENLACES</h4><p>Sobre nosotros</p><p>Ayuda</p></div>
    <div><h4>CONTACTO</h4><p>correo@nirami.com</p></div>
</footer>

<style>
.active-cat { background-color: #4586FF !important; color: white !important; }
</style>
</body>
</html>